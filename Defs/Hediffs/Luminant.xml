<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <HediffDef>
    <defName>VGL_LuminantMantle</defName>
    <label>latent lumen</label>
    <description>A singular psychic resonance, neither inherited nor duplicable. Its protective response is sporadic in childhood, but it grows with training and age.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <maxSeverity>4</maxSeverity>
    <stages>
      <li><minSeverity>0</minSeverity><label>latent</label></li>
      <li><minSeverity>1</minSeverity><label>first light</label></li>
      <li><minSeverity>2</minSeverity><label>shaping radiance</label></li>
      <li><minSeverity>3</minSeverity><label>mature lumen</label></li>
    </stages>
  </HediffDef>
  <HediffDef>
    <defName>VGL_LuminousWard</defName>
    <label>luminous ward</label>
    <description>A brief protective field woven from controlled psychic light.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <stages><li><label>warded</label></li></stages>
    <comps><li Class="HediffCompProperties_Disappears"><disappearsAfterTicks>1800</disappearsAfterTicks></li></comps>
  </HediffDef>
  <HediffDef>
    <defName>VGL_SecondSight</defName>
    <label>second sight</label>
    <description>A heightened awareness of nearby disturbances in the psychic field. True invisibility detection will require a later dedicated patch.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <stages><li><capMods><li><capacity>Sight</capacity><offset>0.1</offset></li></capMods></li></stages>
    <comps><li Class="HediffCompProperties_Disappears"><disappearsAfterTicks>1800</disappearsAfterTicks></li></comps>
  </HediffDef>
</Defs>
