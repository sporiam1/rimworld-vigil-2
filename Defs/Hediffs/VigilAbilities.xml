<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Aegis: −40% incoming damage (applied in Patch_GradualAwakening). 30 seconds. -->
  <HediffDef>
    <defName>VGL_Aegis</defName>
    <label>aegis</label>
    <description>VIGIL's Guardian protocol: a projected ward that blunts incoming harm.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <defaultLabelColor>(0.5, 0.9, 1)</defaultLabelColor>
    <stages><li><label>warded</label></li></stages>
    <comps><li Class="HediffCompProperties_Disappears"><disappearsAfterTicks>1800</disappearsAfterTicks><showRemainingTime>true</showRemainingTime></li></comps>
  </HediffDef>

  <!-- Verdict: slowed, clumsy, +15% damage taken (in Patch_GradualAwakening). 40 seconds. -->
  <HediffDef>
    <defName>VGL_Judged</defName>
    <label>judged</label>
    <description>VIGIL's Arbiter protocol has passed judgment. The weight of it slows every movement.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <defaultLabelColor>(0.75, 0.55, 1)</defaultLabelColor>
    <stages>
      <li>
        <label>judged</label>
        <capMods><li><capacity>Moving</capacity><offset>-0.25</offset></li></capMods>
        <statOffsets><MeleeHitChance>-4</MeleeHitChance><ShootingAccuracyPawn>-4</ShootingAccuracyPawn></statOffsets>
      </li>
    </stages>
    <comps><li Class="HediffCompProperties_Disappears"><disappearsAfterTicks>2400</disappearsAfterTicks><showRemainingTime>true</showRemainingTime></li></comps>
  </HediffDef>

  <!-- Last Stand: VIGIL holds its bearer up. 30 seconds. -->
  <HediffDef>
    <defName>VGL_LastStand</defName>
    <label>last stand</label>
    <description>VIGIL refuses to let its bearer fall. Pain recedes and his focus sharpens, for a little while.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <defaultLabelColor>(1, 0.85, 0.4)</defaultLabelColor>
    <stages>
      <li>
        <label>standing</label>
        <painFactor>0.2</painFactor>
        <capMods><li><capacity>Consciousness</capacity><offset>0.15</offset></li></capMods>
        <statOffsets><MeleeHitChance>4</MeleeHitChance></statOffsets>
      </li>
    </stages>
    <comps><li Class="HediffCompProperties_Disappears"><disappearsAfterTicks>1800</disappearsAfterTicks><showRemainingTime>true</showRemainingTime></li></comps>
  </HediffDef>

  <!-- Present while he is VIGIL's bearer. In hand: severity = awakening stage (1–3) with bonuses.
       Sword put away: severity 0.5, the "apart" stage, no bonuses. -->
  <HediffDef>
    <defName>VGL_VigilBond</defName>
    <label>VIGIL's bond</label>
    <description>The persona core of VIGIL is joined to its bearer's mind. In his hand, its strength grows as the sword awakens. Apart from him, the bond remains, but lends nothing.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <defaultLabelColor>(0.9, 0.8, 0.5)</defaultLabelColor>
    <initialSeverity>0.5</initialSeverity>
    <minSeverity>0.1</minSeverity>
    <maxSeverity>3</maxSeverity>
    <stages>
      <li>
        <minSeverity>0.1</minSeverity>
        <label>apart</label>
      </li>
      <li>
        <minSeverity>1</minSeverity>
        <label>bound</label>
        <statOffsets><MeleeHitChance>2</MeleeHitChance></statOffsets>
      </li>
      <li>
        <minSeverity>2</minSeverity>
        <label>awakened</label>
        <statOffsets><MeleeHitChance>4</MeleeHitChance></statOffsets>
        <statFactors><MeleeDamageFactor>1.15</MeleeDamageFactor></statFactors>
      </li>
      <li>
        <minSeverity>3</minSeverity>
        <label>ascendant</label>
        <statOffsets><MeleeHitChance>6</MeleeHitChance><MeleeDodgeChance>4</MeleeDodgeChance></statOffsets>
        <statFactors><MeleeDamageFactor>1.3</MeleeDamageFactor></statFactors>
      </li>
    </stages>
  </HediffDef>
</Defs>
