<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Schema checked against VPE source (PsycasterPathDef / AbilityExtension_Psycast).
       Class= makes VPE use LuministPathDef, whose CanPawnUnlock admits only the living Luminant. -->
  <VanillaPsycastsExpanded.PsycasterPathDef Class="VigilForgottenBond.LuministPathDef">
    <defName>VGL_Luminist</defName>
    <label>luminist</label>
    <description>A singular discipline of stabilizing psychic light. Sanctuary, Revelation, and Judgment converge at the final dawn. Only the current Luminant may learn these psycasts.</description>
    <background>UI/Psycasts/PathBG_Luminist</background>
    <altBackground>UI/Psycasts/PathBG_Luminist_Alternate</altBackground>
    <tab>Luminant</tab>
    <lockedReason>only the living Luminant, after her First Light</lockedReason>
    <!-- Enforce the lock at cast time too (VPE skips it for neurotrainer paths by default). -->
    <ignoreLockRestrictionsForNeurotrainers>false</ignoreLockRestrictionsForNeurotrainers>
    <!-- Re-check whenever her hediffs change: a former Luminant loses the path, and regains it if the mantle returns. -->
    <ensureLockRequirement>true</ensureLockRequirement>
    <tooltip>An exclusive discipline of radiant psychic energy, learned only by the one living Luminant. Its paths emphasize protection, revelation, and judgment.</tooltip>
  </VanillaPsycastsExpanded.PsycasterPathDef>
  <!-- First playable subset: three tier-I powers. Fifteen-node plan is in Docs/PSYCAST_TREE.md. -->
  <VEF.Abilities.AbilityDef ParentName="VPE_PsycastBase">
    <defName>VGL_LuminousWardCast</defName>
    <label>luminous ward</label>
    <description>Shields an ally from a portion of incoming damage for a short time.</description>
    <iconPath>Vigil/Icons/LuminousWard</iconPath>
    <abilityClass>VigilForgottenBond.Ability_LuministSupport</abilityClass>
    <targetMode>Pawn</targetMode><range>16</range><castTime>60</castTime><durationTime>1800</durationTime>
    <targetingParameters><canTargetPawns>true</canTargetPawns><canTargetSelf>true</canTargetSelf><canTargetHumans>true</canTargetHumans></targetingParameters>
    <modExtensions>
      <li Class="VanillaPsycastsExpanded.AbilityExtension_Psycast"><path>VGL_Luminist</path><level>1</level><order>1</order><psyfocusCost>0.05</psyfocusCost><entropyGain>8</entropyGain><psychic>true</psychic></li>
      <li Class="VEF.Abilities.AbilityExtension_Hediff"><hediff>VGL_LuminousWard</hediff></li>
    </modExtensions>
  </VEF.Abilities.AbilityDef>
  <VEF.Abilities.AbilityDef ParentName="VPE_PsycastBase">
    <defName>VGL_SecondSightCast</defName>
    <label>second sight</label>
    <description>Temporarily enhances the Luminant's senses. Later iterations will reveal selected hidden Void entities.</description>
    <iconPath>Vigil/Icons/SecondSight</iconPath>
    <abilityClass>VigilForgottenBond.Ability_LuministSupport</abilityClass>
    <targetMode>Self</targetMode><range>0</range><castTime>45</castTime><durationTime>1800</durationTime>
    <targetingParameters><canTargetPawns>true</canTargetPawns><canTargetSelf>true</canTargetSelf></targetingParameters>
    <modExtensions>
      <li Class="VanillaPsycastsExpanded.AbilityExtension_Psycast"><path>VGL_Luminist</path><level>1</level><order>2</order><psyfocusCost>0.03</psyfocusCost><entropyGain>5</entropyGain><psychic>true</psychic></li>
      <li Class="VEF.Abilities.AbilityExtension_Hediff"><hediff>VGL_SecondSight</hediff></li>
    </modExtensions>
  </VEF.Abilities.AbilityDef>
  <VEF.Abilities.AbilityDef ParentName="VPE_PsycastBase">
    <defName>VGL_RadiantSparkCast</defName>
    <label>radiant spark</label>
    <description>A narrow pulse of charged psychic light, capable of wounding a hostile target.</description>
    <iconPath>Vigil/Icons/RadiantSpark</iconPath>
    <abilityClass>VigilForgottenBond.Ability_LuministProjectile</abilityClass>
    <targetMode>Pawn</targetMode><range>16</range><castTime>45</castTime>
    <targetingParameters><canTargetPawns>true</canTargetPawns><canTargetHumans>true</canTargetHumans><canTargetMechs>true</canTargetMechs><canTargetSelf>false</canTargetSelf></targetingParameters>
    <modExtensions>
      <li Class="VanillaPsycastsExpanded.AbilityExtension_Psycast"><path>VGL_Luminist</path><level>1</level><order>3</order><psyfocusCost>0.04</psyfocusCost><entropyGain>10</entropyGain><psychic>true</psychic></li>
      <li Class="VEF.Abilities.AbilityExtension_Projectile"><projectile>VGL_RadiantBolt</projectile><hitFlags>All</hitFlags></li>
    </modExtensions>
  </VEF.Abilities.AbilityDef>
  <ThingDef ParentName="BaseBullet">
    <defName>VGL_RadiantBolt</defName>
    <label>radiant spark bolt</label>
    <graphicData><texPath>Vigil/Icons/RadiantSpark</texPath><graphicClass>Graphic_Single</graphicClass><drawSize>0.3</drawSize></graphicData>
    <projectile><damageDef>Burn</damageDef><damageAmountBase>8</damageAmountBase><speed>34</speed></projectile>
  </ThingDef>
</Defs>
